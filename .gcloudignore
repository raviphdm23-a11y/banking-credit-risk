# GCP deployment exclusions
# Files listed here are NOT uploaded to App Engine

# Git
.gcloudignore
.git
.gitignore

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Environment & secrets
.env
.env.*

# Logs
*.log

# Virtual environments
venv/
venv310/

# Local dev launchers
run_flask.ps1

# Old standalone training script (superseded by ml_models/trainer.py)
train_pd_model.py

# Development & session documentation
BUG_FIX_LOG.md
CLEANUP_COMPLETE.md
DEPLOYMENT_GUIDE.md
ML_MODEL_GUIDE.md
