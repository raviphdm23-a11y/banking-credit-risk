README_DEPLOYMENT.md

# Legacy pages (not served in production)
public/api-test.html
public/pd-calculator.html

# Temporary dev-only helpers (e.g. form autofill test button) — never ship to prod
public/_dev/

# All testing scripts (not needed at runtime on GCP)
testing/

# Data runtime directories (ephemeral on GCP — regenerated via admin panel)
data/archive/
data/synthetic/
data/runs/
data/reports/
data/case_reports/
data/financial_reports/
