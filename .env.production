# Production Environment Configuration
# Used for Cloud Run deployment

# GCP & Cloud Storage
GCP_PROJECT_ID=render-demo-06062141
GCS_DATA_BUCKET=banking-credit-risk-data
GCS_MODELS_BUCKET=banking-credit-risk-data
GCS_REPORTS_BUCKET=banking-credit-risk-reports
GCS_AUDIT_BUCKET=banking-credit-risk-audit

# Environment Detection
READONLY_FS=true
FLASK_ENV=production

# Logging
LOG_LEVEL=info

# Flask Configuration
SECRET_KEY=change-me-in-production
DEBUG=false

# Database (will be downloaded from GCS to /tmp on startup)
DATABASE_URL=sqlite:////tmp/bank.db

# ML Models (will be downloaded from GCS to /tmp/ml_models on startup)
MODELS_DIR=/tmp/ml_models

# Data Directory (ephemeral, for reports/audit logs before upload to GCS)
DATA_DIR=/tmp/data
