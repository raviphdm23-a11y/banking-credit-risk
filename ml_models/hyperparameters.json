{
  "model": {
    "n_estimators": 200,
    "max_depth": 4,
    "learning_rate": 0.05,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "min_child_weight": 5,
    "gamma": 0.1,
    "reg_alpha": 0.1,
    "reg_lambda": 1.0,
    "scale_pos_weight": 1,
    "random_state": 42
  },
  "training": {
    "test_size": 0.2,
    "pd_classification_threshold": 0.25,
    "min_rows_floor": 100
  },
  "schedule": {
    "enabled": true,
    "frequency": "weekly",
    "day_of_week": "sun",
    "hour": 2,
    "minute": 0
  }
}
